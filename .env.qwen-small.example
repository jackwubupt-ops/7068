# Copy these values to your local .env. Never commit .env.
PATCHLOOP_MODEL_BACKEND=qwen
QWEN_MODEL=Qwen/Qwen2.5-Coder-0.5B-Instruct
# Proposal base model: QWEN_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct (also set QWEN_TIMEOUT=300)
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_API_KEY=EMPTY
QWEN_MAX_CALLS=20
QWEN_CONTEXT_CHARS=18500
QWEN_TIMEOUT=100

# Server-side only (read by scripts/start_qwen_small.sh, not by the client):
# QWEN_MODEL_PATH=/root/autodl-tmp/qwen-models/Qwen2.5-Coder-0.5B-Instruct
# QWEN_MAX_MODEL_LEN=16384
# QWEN_GPU_MEMORY_UTIL=0.65
# QWEN_ENFORCE_EAGER=0

# Optional second backend: hosted DeepSeek API (stronger model; issue text and
# the code the agent reads are SENT to DeepSeek and billed). Never commit .env.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash        # or deepseek-v4-pro
# DEEPSEEK_REASONING_EFFORT=none       # RQ1: none (thinking off, default) | low | high | max
# Optional overrides (defaults depend on the effort; see patchloop_task2/backends.py):
# DEEPSEEK_REASONING_TOKENS_PER_CALL=
# DEEPSEEK_REASONING_BUDGET=
